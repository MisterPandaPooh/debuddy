{
  "name": "explain-mode",
  "displayName": "Explain Mode",
  "description": "Step through code like a debugger; a local LLM explains each statement.",
  "version": "0.0.1",
  "publisher": "netanelcs",
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Debuggers",
    "Programming Languages"
  ],
  "activationEvents": [
    "onDebug",
    "onCommand:explain.startHere"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "explain.startHere",
        "title": "Explain Mode: Start Here",
        "category": "Explain"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "explain.startHere",
          "when": "editorLangId =~ /typescript|javascript/",
          "group": "navigation@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "explain.startHere",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorTextFocus && !inDebugMode"
      }
    ],
    "breakpoints": [
      {
        "language": "typescript"
      },
      {
        "language": "javascript"
      }
    ],
    "debuggers": [
      {
        "type": "explain",
        "label": "Explain Mode",
        "languages": [
          "typescript",
          "javascript"
        ],
        "initialConfigurations": [
          {
            "type": "explain",
            "request": "launch",
            "name": "Explain Mode: Start Here"
          }
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "file": {
                "type": "string",
                "description": "File to start in."
              },
              "line": {
                "type": "number",
                "description": "1-based line to start at."
              }
            }
          }
        }
      }
    ],
    "configuration": {
      "title": "Explain Mode",
      "properties": {
        "explain.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434"
        },
        "explain.model": {
          "type": "string",
          "default": "qwen2.5-coder:3b"
        },
        "explain.context.fullFunctionMaxLines": {
          "type": "number",
          "default": 60,
          "description": "Functions up to this many lines are sent whole; longer ones get a window around the statement."
        },
        "explain.context.before": {
          "type": "number",
          "default": 15,
          "description": "Lines before the current statement in the window (long functions only)."
        },
        "explain.context.after": {
          "type": "number",
          "default": 8,
          "description": "Lines after the current statement in the window (long functions only)."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit",
    "bench": "node bench/bench.mjs",
    "test:dap": "esbuild src/adapter.ts --bundle --platform=node --format=cjs --outfile=test/adapter.bundle.js --alias:vscode=./test/vscode-stub.js && node test/dap.js sample/user.service.ts 11 13"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/vscode": "^1.95.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@vscode/debugadapter": "^1.68.0",
    "@vscode/debugprotocol": "^1.68.0"
  }
}
