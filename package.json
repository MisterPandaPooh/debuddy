{
  "name": "explain-mode",
  "displayName": "Explain Mode",
  "description": "Step through code like a debugger; a local LLM explains each statement.",
  "version": "0.0.1",
  "publisher": "netanelcs",
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Debuggers",
    "Programming Languages"
  ],
  "activationEvents": [
    "onDebug",
    "onCommand:explain.startHere"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "explain.startHere",
        "title": "Explain Mode: Start Here",
        "category": "Explain"
      },
      {
        "command": "explain.autoWalk",
        "title": "Explain Mode: Auto-walk",
        "category": "Explain",
        "icon": "$(run-all)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "explain.startHere",
          "when": "editorLangId =~ /typescript|javascript/",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "explain.autoWalk",
          "when": "explain.active",
          "group": "navigation@0"
        }
      ],
      "debug/toolBar": [
        {
          "command": "explain.autoWalk",
          "when": "explain.active",
          "group": "navigation@0"
        }
      ]
    },
    "keybindings": [
      {
        "command": "explain.startHere",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorTextFocus && !inDebugMode"
      },
      {
        "command": "explain.autoWalk",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "explain.active"
      }
    ],
    "breakpoints": [
      {
        "language": "typescript"
      },
      {
        "language": "javascript"
      }
    ],
    "debuggers": [
      {
        "type": "explain",
        "label": "Explain Mode",
        "languages": [
          "typescript",
          "javascript"
        ],
        "initialConfigurations": [
          {
            "type": "explain",
            "request": "launch",
            "name": "Explain Mode: Start Here"
          }
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "file": {
                "type": "string",
                "description": "File to start in."
              },
              "line": {
                "type": "number",
                "description": "1-based line to start at."
              }
            }
          }
        }
      }
    ],
    "configuration": {
      "title": "Explain Mode",
      "properties": {
        "explain.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434"
        },
        "explain.model": {
          "type": "string",
          "default": "qwen2.5-coder:3b"
        },
        "explain.context.fullFunctionMaxLines": {
          "type": "number",
          "default": 60,
          "description": "Functions up to this many lines are sent whole; longer ones get a window around the statement."
        },
        "explain.context.before": {
          "type": "number",
          "default": 15,
          "description": "Lines before the current statement in the window (long functions only)."
        },
        "explain.context.after": {
          "type": "number",
          "default": 8,
          "description": "Lines after the current statement in the window (long functions only)."
        },
        "explain.context.definitionDepth": {
          "type": "number",
          "default": 2,
          "description": "Go-to-definition levels resolved below the current statement; each level's functions are summarized and fed to the level above."
        },
        "explain.auto.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Make Continue (F5) auto-walk instead of running silently to the next breakpoint. Off by default: F5 runs to the next breakpoint, the \u25b6\u25b6 toolbar button (Cmd+Alt+A) starts the auto-walk."
        },
        "explain.auto.dwellMs": {
          "type": "number",
          "default": 3000,
          "description": "Time to stay on each statement in auto mode, after its explanation is shown."
        },
        "explain.askBranch": {
          "type": "boolean",
          "default": true,
          "description": "On Step Over at an `if`, ask which branch to follow; the other one is skipped."
        }
      }
    },
    "activationEvents": [
      "onDebug",
      "onCommand:explain.startHere",
      "onCommand:explain.autoWalk"
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit",
    "bench": "node bench/bench.mjs",
    "test:dap": "esbuild src/adapter.ts --bundle --platform=node --format=cjs --outfile=test/adapter.bundle.js --alias:vscode=./test/vscode-stub.js && node test/dap.js sample/user.service.ts 11 13",
    "test:dap:auto": "EXPLAIN_AUTO=1 npm run test:dap"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/vscode": "^1.95.0",
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "@vscode/debugadapter": "^1.68.0",
    "@vscode/debugprotocol": "^1.68.0",
    "typescript": "^5.9.3"
  }
}
